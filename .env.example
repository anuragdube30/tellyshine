# Telly Shine local development
# SQLite database - no Docker/PostgreSQL required
DATABASE_URL="file:./dev.db"

# NextAuth session encryption secret (local development only)
AUTH_SECRET="tellyshine-local-secret-change-me"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Cloudinary credentials for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
