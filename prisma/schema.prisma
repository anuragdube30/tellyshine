generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH / USERS ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("EDITOR")
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  news     News[]
  sessions Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- TAXONOMY ----------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news    News[]
  videos  Video[]
  serials Serial[]

  @@index([slug])
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique
  news News[] @relation("NewsTags")
}

// ---------- NEWS ----------

model News {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  featuredImage  String
  status         String    @default("DRAFT")
  publishedAt    DateTime?
  scheduledFor   DateTime?
  views          Int       @default(0)
  seoTitle       String?
  seoDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  tags       Tag[]    @relation("NewsTags")

  celebrities CelebrityOnNews[]
  serials     SerialOnNews[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
}

// ---------- TV SERIALS ----------

model Serial {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  poster          String
  banner          String
  description     String
  channel         String
  genre           String
  cast            String
  status          String    @default("ONGOING")
  startDate       DateTime?
  latestEpisode   String?
  upcomingEpisode String?
  featured        Boolean   @default(false)
  views           Int       @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  episodes    Episode[]
  news        SerialOnNews[]
  celebrities CelebrityOnSerial[]
  videos      Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model Episode {
  id          String    @id @default(cuid())
  serialId    String
  serial      Serial    @relation(fields: [serialId], references: [id], onDelete: Cascade)
  title       String
  episodeNo   Int
  airDate     DateTime?
  description String?
  thumbnail   String?
  createdAt   DateTime  @default(now())

  @@index([serialId])
}

// ---------- JOIN TABLE: NEWS <-> SERIAL ----------

model SerialOnNews {
  serialId String
  newsId   String
  serial   Serial @relation(fields: [serialId], references: [id], onDelete: Cascade)
  news     News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([serialId, newsId])
}

// ---------- VIDEOS ----------

model Video {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  youtubeUrl  String
  thumbnail   String
  duration    String?
  views       Int     @default(0)
  isPublished Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  serialId   String?
  serial     Serial?   @relation(fields: [serialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ---------- CELEBRITIES ----------

model Celebrity {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  profileImage String
  coverImage   String?
  biography    String
  profession   String
  socialLinks  String?
  featured     Boolean @default(false)

  news    CelebrityOnNews[]
  serials CelebrityOnSerial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model CelebrityOnNews {
  celebrityId String
  newsId      String
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  news        News      @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([celebrityId, newsId])
}

model CelebrityOnSerial {
  celebrityId String
  serialId    String
  role        String?
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  serial      Serial    @relation(fields: [serialId], references: [id], onDelete: Cascade)

  @@id([celebrityId, serialId])
}

// ---------- BREAKING NEWS ----------

model BreakingNews {
  id        String   @id @default(cuid())
  text      String
  link      String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive, order])
}

// ---------- CONTACT MESSAGES ----------

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, createdAt])
}

// ---------- MEDIA LIBRARY ----------

model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  type      String
  alt       String?
  createdAt DateTime @default(now())
}

// ---------- SITE SETTINGS (singleton) ----------

model SiteSettings {
  id              String   @id @default("singleton")
  siteName        String   @default("Telly Shine")
  logoUrl         String?
  faviconUrl      String?
  description     String?
  contactEmail    String?
  socialLinks     String?
  footerText      String?
  accentColor     String   @default("#f2a71b")
  seoDefaultTitle String?
  seoDefaultDesc  String?
  updatedAt       DateTime @updatedAt
}
